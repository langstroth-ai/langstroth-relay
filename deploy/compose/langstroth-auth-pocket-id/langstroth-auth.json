{
  "listen": ":8090",
  "public_url": "https://auth.example.com",
  "signing_key_file": "/etc/langstroth-auth/secrets/signing-key",
  "store": {"driver": "file", "path": "/var/lib/langstroth-auth/state.json"},
  "access_ttl": "15m",
  "refresh_idle_ttl": "168h",
  "session_max_age": "720h",
  "trusted_proxies": ["172.16.0.0/12"],
  "tenants": [
    {
      "id": "home",
      "display_name": "Home",
      "oidc": {
        "issuer": "https://id.example.com",
        "client_id": "REPLACE-with-the-pocket-id-client-id",
        "client_secret_file": "/etc/langstroth-auth/secrets/pocket-id-client-secret",
        "scopes": ["openid", "email", "profile", "groups"]
      },
      "provisioning": "jit",
      "idp_groups": true,
      "workspaces": ["*"],
      "grants": {"ligus": ["*"]}
    }
  ]
}
